.DS_Store
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.cache/

# Model weights and generated runtime output
*.pt
*.onnx
*.mlpackage
runs/
artifacts/
results/*.json
results/*.jsonl
logs/

# Local/generated research deliverables; may contain personal or submission data
*.docx
*.pdf
*.pptx
*.xlsx
*.xls
*.zip
/output/
/outputs/

# Public Markdown documentation is versioned; private thesis material stays local.
docs/private/

# Research data stay local. GitHub contains source, not dataset files/templates.
/data/

# Keep only the runtime config used by the pretrained integration baseline.
/configs/*
!/configs/pretrained_indoor.toml

# Historical data/review utilities stay local; keep one reproducible smoke asset helper.
/scripts/*
!/scripts/fetch_smoke_asset.py

# Local historical dataset QA test depends on ignored review utilities.
tests/unit/test_indoor_v12_gate.py

# Local document/PDF QA artifacts
.codex-doc-review/
tmp/
